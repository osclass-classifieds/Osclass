{
  "name": "osclasspoint/osclass",
  "description": "Osclass is your one-stop shop to building your own classifieds website.",
  "keywords": ["osclass","osclasspoint","classified","open-source","php classified","marketplace script","cms"],
  "homepage": "https://osclass-classifieds.com/",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "OsclassPoint",
      "homepage": "https://osclasspoint.com/"
    }
  ],
  "config": {
    "vendor-dir": "oc-includes/vendor",
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4"
    }
  },
  "require": {
    "php": ">=7.2.0",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-mysqli": "*",
    "ext-zip": "*",
    "ext-curl": "*",
    "ext-posix": "*",
    "ext-fileinfo": "*",
    "ezyang/htmlpurifier": "4.19.x",
    "phpmailer/phpmailer": "7.0.x",
    "pclzip/pclzip": "2.8.x",
    "phpseclib/phpseclib": "3.0.x",
    "pensiero/php-openssl-cryptor": "0.1.x",
    "google/recaptcha": "1.2.x",
    "gettext/translator": "1.2.x",
    "gettext/gettext": "5.7.x",
    "gettext/php-scanner": "2.0.x",
    "matthiasmullie/minify": "1.3.x",
    "nikic/php-parser": "5.7.x"
  }
}